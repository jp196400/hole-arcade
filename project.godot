config_version=5

[application]
config/name="Hole Arcade"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
Save="*res://save_game.gd"
HapticService="*res://haptic_service.gd"
IapService="*res://iap_service.gd"
AdService="*res://ad_service.gd"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/handheld/orientation=1
window/dpi/allow_hidpi=true

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=false

[audio]
driver/driver="Dummy"

[rendering]
; Web exports ship with threads off. Past this many 3D instances Godot
; takes a threaded cull that draws nothing, so the world goes blank.
limits/spatial_indexer/threaded_cull_minimum_instances=100000
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.11, 0.16, 0.29, 1)
textures/vram_compression/import_etc2_astc=true
scaling_3d/mode=0
scaling_3d/scale=1.5
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/atlas_size=1024
shading/overrides/force_lambert_over_burley=true
driver/depth_prepass/enable=false
