config_version=5

[application]
config/name="Hole Arcade"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
Save="*res://save_game.gd"
IapService="*res://iap_service.gd"
AdService="*res://ad_service.gd"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/handheld/orientation=1
window/dpi/allow_hidpi=false

[input_devices]
pointing/emulate_touch_from_mouse=true

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=false

[audio]
driver/driver="Dummy"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
scaling_3d/mode=0
scaling_3d/scale=0.5
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/atlas_size=1024
shading/overrides/force_lambert_over_burley=true
driver/depth_prepass/enable=false
